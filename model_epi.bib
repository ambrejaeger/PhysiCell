}

@article{mu_exploring_2024,
	title = {Exploring the Regulators of Keratinization: Role of {BMP}-2 in Oral Mucosa},
	volume = {13},
	rights = {http://creativecommons.org/licenses/by/3.0/},
	issn = {2073-4409},
	url = {https://www.mdpi.com/2073-4409/13/10/807},
	doi = {10.3390/cells13100807},
	shorttitle = {Exploring the Regulators of Keratinization},
	abstract = {The oral mucosa functions as a physico-chemical and immune barrier to external stimuli, and an adequate width of the keratinized mucosa around the teeth or implants is crucial to maintaining them in a healthy and stable condition. In this study, for the first time, bulk {RNA}-seq analysis was performed to explore the gene expression of laser microdissected epithelium and lamina propria from mice, aiming to investigate the differences between keratinized and non-keratinized oral mucosa. Based on the differentially expressed genes ({DEGs}) and Gene Ontology ({GO}) Enrichment Analysis, bone morphogenetic protein 2 ({BMP}-2) was identified to be a potential regulator of oral mucosal keratinization. Monoculture and epithelial–mesenchymal cell co-culture models in the air–liquid interface ({ALI}) indicated that {BMP}-2 has direct and positive effects on epithelial keratinization and proliferation. We further performed bulk {RNA}-seq of the {ALI} monoculture stimulated with {BMP}-2 in an attempt to identify the downstream factors promoting epithelial keratinization and proliferation. Analysis of the {DEGs} identified, among others, {IGF}2, {ID}1, {LTBP}1, {LOX}, {SERPINE}1, {IL}24, and {MMP}1 as key factors. In summary, these results revealed the involvement of a well-known growth factor responsible for bone development, {BMP}-2, in the mechanism of oral mucosal keratinization and proliferation, and pointed out the possible downstream genes involved in this mechanism.},
	pages = {807},
	number = {10},
	journaltitle = {Cells},
	author = {Mu, Xindi and Ono, Mitsuaki and Nguyen, Ha Thi Thu and Wang, Ziyi and Zhao, Kun and Komori, Taishi and Yonezawa, Tomoko and Kuboki, Takuo and Oohashi, Toshitaka},
	urldate = {2025-10-06},
	date = {2024-01},
	langid = {english},
	note = {Publisher: Multidisciplinary Digital Publishing Institute},
	keywords = {extracellular matrix ({ECM}), bioinformatics, cell differentiation, epithelia, growth factor(s), mucocutaneous disorders},
	file = {Full Text PDF:/home/ajaeger/Zotero/storage/9P6XILHW/Mu et al. - 2024 - Exploring the Regulators of Keratinization Role of BMP-2 in Oral Mucosa.pdf:application/pdf},
}

