}

@article{lefort_notch_2004,
	title = {Notch signaling in the integrated control of keratinocyte growth/differentiation and tumor suppression},
	volume = {14},
	issn = {1044-579X},
	url = {https://www.sciencedirect.com/science/article/pii/S1044579X04000343},
