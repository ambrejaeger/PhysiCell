	urldate = {2025-10-02},
	date = {2021-10-01},
	keywords = {Diagnostic, Genetic alterations, Oral cavity cancer ({OCC}), Oral cavity squamous cell carcinoma ({OCSCC}), Risk factor, Signaling, Treatment},
