@article{squier_biology_2001,
	title = {Biology of Oral Mucosa and Esophagus},
	volume = {2001},
	issn = {1052-6773},
	url = {https://doi.org/10.1093/oxfordjournals.jncimonographs.a003443},
	doi = {10.1093/oxfordjournals.jncimonographs.a003443},
	abstract = {The mucosal lining of the oral cavity and esophagus functions to protect the underlying tissue from mechanical damage and from the entry of microorganisms and toxic materials that may be present in the oropharynx. In different regions, the mucosa shows adaptation to differing mechanical demands: Masticatory mucosa consists of a stratified squamous keratinized epithelium tightly attached to the underlying tissues by a collagenous connective tissue, whereas lining mucosa comprises a nonkeratinized epithelium supported by a more elastic and flexible connective tissue. The epithelium is constantly replaced by cell division in the deeper layers, and turnover is faster in the lining than in the masticatory regions. Chemotherapeutic agents and radiation limit proliferation of the epithelium so that it becomes thin or ulcerated; this will first occur in the lining regions. The principal patterns of epithelial differentiation are represented by keratinization and nonkeratinization. As keratinocytes enter into differentiation, they become larger and begin to flatten and to accumulate cytokeratin filaments. In addition to the keratins, the differentiating keratinocytes synthesize and retain a number of specific proteins, including profilaggrin, involucrin, and other precursors of the thickening of the cell envelope in the most superficial layers. The concept of epithelial homeostasis implies that cell production in the deeper layers will be balanced by loss of cells from the surface. There is a rapid clearance of surface cells, which acts as a protective mechanism by limiting colonization and invasion of microorganisms adherent to the mucosal surface. [J Natl Cancer Inst Monogr 2001;29:7–15]},
	pages = {7--15},
	number = {29},
	journaltitle = {{JNCI} Monographs},
	shortjournal = {J Natl Cancer Inst Monogr},
	author = {Squier, Christopher A. and Kremer, Mary J.},
	urldate = {2025-10-01},
	date = {2001-10-01},
	file = {Full Text PDF:/home/ajaeger/Zotero/storage/FEHPVNHG/Squier et Kremer - 2001 - Biology of Oral Mucosa and Esophagus.pdf:application/pdf},
}

@article{mackenzie_maintenance_1981,
	title = {Maintenance of regionally specific patterns of cell proliferation and differentiation in transplanted skin and oral mucosa},
