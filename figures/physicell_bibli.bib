	author = {Stoll, Gautier and Caron, Barthélémy and Viara, Eric and Dugourd, Aurélien and Zinovyev, Andrei and Naldi, Aurélien and Kroemer, Guido and Barillot, Emmanuel and Calzone, Laurence},
	urldate = {2025-09-29},
