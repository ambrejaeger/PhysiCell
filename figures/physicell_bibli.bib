	keywords = {Simulation, Accuracy, Biological processes, Biological system modeling, Computational Biology, Computational modeling, Data models, Long short term memory, Long Short-Term Memory ({LSTM}), Meta-models, Metamodeling, Modelling, Predictive models, Recurrent Neural Networks, Surrogate Models, Systems Biology, Training, Tumors},
