	note = {Publisher: {GigaScience} Press},
	file = {Full Text PDF:/home/ajaeger/Zotero/storage/HNCBMWMZ/Bergman et al. - 2022 - PhysiPKPD A pharmacokinetics and pharmacodynamics module for PhysiCell.pdf:application/pdf},
}

